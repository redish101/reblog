# 开发环境配置
DEV=false

# 服务器端口
PORT=3000

# 数据库连接URL
# SQLite (开发环境): DATABASE_URL=reblog.db
# PostgreSQL (生产环境): DATABASE_URL=postgres://user:password@localhost:5432/reblog?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5432/reblog?sslmode=disable

# JWT 密钥生成种子 (请更改为随机字符串)
SECRET_KEY=your_secret_key

# 管理员邮箱地址 (拥有完整权限的用户)
OWNER_EMAIL=admin@example.com

# GitHub OAuth 应用配置
# 在 GitHub Settings > Developer settings > OAuth Apps 中创建应用获取
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# GitHub OAuth 回调地址 (需要与 GitHub 应用设置中的回调地址一致)
GITHUB_REDIRECT_URL=http://localhost:3000/api/v1/auth/github/callback

# 前端域名
FRONTEND_URL=https://reblog-for-dev.redish101.top

# 区块链合约地址
COPYRIGHT_CONTRACT_ADDRESS=0x3bc13fB85EfB2b7C8Ab6D1350aCc3f9e91D8b234

# RPC 节点地址 (需wss)
COPYRIGHT_RPC_URL=wss://sepolia.infura.io/ws/v3/xxx

# IPFS API 地址
IPFS_API_URL=http://localhost:5001