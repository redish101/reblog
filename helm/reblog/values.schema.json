{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nameOverride": {
          "type": "string"
        },
        "fullnameOverride": {
          "type": "string"
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["repository"]
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"],
              "default": "ClusterIP"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            }
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "dev": {
              "type": "boolean",
              "default": true
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            },
            "databaseUrl": {
              "type": "string",
              "description": "数据库连接字符串，必须提供"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1,
              "description": "用于生成JWT密钥对的密钥"
            },
            "ownerEmail": {
              "type": "string",
              "format": "email",
              "description": "管理员邮箱地址"
            },
            "github": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "secret": {
                  "type": "string"
                },
                "redirectUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "frontendUrl": {
              "type": "string",
              "format": "uri",
              "description": "前端URL地址"
            }
          },
          "required": ["databaseUrl", "secretKey"]
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "host": {
              "type": "string",
              "description": "后端域名"
            },
            "annotations": {
              "type": "object"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "pathType": {
                    "type": "string",
                    "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                  }
                }
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "type": "string"
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "required": ["host"]
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 80
            },
            "targetMemoryUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["repository"]
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"],
              "default": "ClusterIP"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "host": {
              "type": "string",
              "description": "前端域名"
            },
            "annotations": {
              "type": "object"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "pathType": {
                    "type": "string",
                    "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                  }
                }
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "type": "string"
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "required": ["host"]
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 80
            },
            "targetMemoryUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string",
          "default": "nginx"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "automount": {
          "type": "boolean",
          "default": true
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "required": ["backend", "frontend", "ingress"]
}
